# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Runtime data: DB, encrypted objects, packages, dev keys
backend/var/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/next-env.d.ts
*.tsbuildinfo

# Env (local only; commit *.env.example templates only)
.env
.env.*
.env.*.local
backend/.env
!.env.example

# Local databases, logs, OS/editor files
*.db
*.db-shm
*.db-wal
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# Private keys, certificates and local secret material
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.secret
*.secrets
secrets/
.secret/

# Local databases and logs (in addition to the rules above)
*.sqlite
*.sqlite3
logs/

# Python / Node generated output anywhere in the tree
*.py[cod]
.venv/
node_modules/
.next/
