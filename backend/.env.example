# Copy to backend/.env and fill in. Real environment variables override this file.
# Zoiko Assure runs on PostgreSQL 17 only: the API refuses to start without DATABASE_URL and never falls back to SQLite.
# Local development: the local PostgreSQL service on 127.0.0.1:5433, database `assure`.
# API runtime role — must be assure_app: non-owner, NOSUPERUSER, no BYPASSRLS; row-level security applies to it and start-up
# refuses any other role (provisioned by `python -m app.migrate upgrade`). Never a superuser such as `postgres`:
DATABASE_URL=postgresql+psycopg://assure_app:CHANGE_ME_APP@127.0.0.1:5433/assure
# Owner/migration role (NOSUPERUSER, CREATEROLE) — used only by `python -m app.migrate` (schema, RLS, runtime role):
DATABASE_ADMIN_URL=postgresql+psycopg://assure:CHANGE_ME_OWNER@127.0.0.1:5433/assure
# PostgreSQL test suite only (a disposable database; tests never read DATABASE_URL). Pass these to pytest as
# environment variables; see README "Tests on PostgreSQL".
# ZA_TEST_DATABASE_URL=postgresql+psycopg://assure_app:CHANGE_ME_APP@127.0.0.1:5433/assure_test
# ZA_TEST_DATABASE_ADMIN_URL=postgresql+psycopg://assure:CHANGE_ME_OWNER@127.0.0.1:5433/assure_test
# Production: no production database exists yet. When one is provisioned, its URLs come from the deployment's secret
# store (ZA_DATABASE_URL / ZA_MIGRATION_DATABASE_URL in CI/CD), never from this file.

# Environment name: development | test | staging | production (deployments set it; see deploy-environment.yml).
# ZA_DEV_IDENTITY_HEADER=1 (the unauthenticated X-Actor-Id header used by the test suite) is refused at start-up unless
# this is development or test.
# ZA_ENVIRONMENT=development

# Optional, development only: migrate an explicitly approved, disposable local database at API start-up
# (docs/database-migrations.md, "Automatic migration of a disposable development database"). Needs
# ZA_ENVIRONMENT=development, the exact host:port/database allowlisted below, a loopback host, and the owner's approval
# comment on the database. The canonical `assure` database is never migrated automatically.
# ZA_AUTO_MIGRATE=true
# ZA_AUTO_MIGRATE_DATABASES=127.0.0.1:5433/assure_dev_scratch
# ZA_PROTECTED_DATABASES=

# Demo/dev only, off by default. ZA_DEMO_MODE=1 seeds the synthetic Customer Zero fixture into an EMPTY database
# and creates demo sign-in accounts only if you also choose a local ZA_DEMO_PASSWORD (none is built in).
ZA_DEMO_MODE=0
# ZA_DEMO_PASSWORD=

# One-time bootstrap accounts (app/accounts.py). Each is created by `python -m app.migrate upgrade` only if no account with that email exists;
# existing accounts and passwords are never changed. Passwords need 10+ characters with upper- and lower-case letters
# and a digit, and are stored only as hashes. Keep real values in backend/.env only (git-ignored), never in frontend env.
# Platform Super Admin (manages customer organisations; no access to customer evidence or assurance data):
# ZA_BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@example.com
# ZA_BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME
# ZA_BOOTSTRAP_SUPER_ADMIN_NAME=Super Admin
# Organisation Admin (role TENANT_OWNER) of the initial customer organisation, which must already exist:
# ZA_BOOTSTRAP_ORG_TENANT_ID=
# ZA_BOOTSTRAP_ORG_ADMIN_EMAIL=orgadmin@example.com
# ZA_BOOTSTRAP_ORG_ADMIN_PASSWORD=CHANGE_ME
# ZA_BOOTSTRAP_ORG_ADMIN_NAME=Organisation Admin
