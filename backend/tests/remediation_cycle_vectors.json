{
  "contract": "The record_seq at which an issue's current remediation cycle began: the latest event that entered IN_REMEDIATION from another state (from_state null, as a migration-0008 BASELINE, or not IN_REMEDIATION), else null. An event that stays in IN_REMEDIATION (an owner reassignment) is not an entry. ZA-STA-001 §17: closure needs remediation plus a new test/evidence cycle. Shared by backend tests/test_remediation_cycle.py (governance._remediation_started_seq) and frontend lib/issues.test.mjs (remediationStartSeq).",
  "vectors": [
    {"name": "no events", "events": [], "expected": null},
    {"name": "never in remediation",
     "events": [["CREATED", null, "OPEN", 1], ["ASSIGNED", "OPEN", "OPEN", 2], ["TRIAGED", "OPEN", "TRIAGED", 3]],
     "expected": null},
    {"name": "entry from TRIAGED",
     "events": [["CREATED", null, "OPEN", 1], ["TRIAGED", "OPEN", "TRIAGED", 3], ["IN_REMEDIATION", "TRIAGED", "IN_REMEDIATION", 5]],
     "expected": 5},
    {"name": "owner reassigned during remediation",
     "events": [["TRIAGED", "OPEN", "TRIAGED", 3], ["IN_REMEDIATION", "TRIAGED", "IN_REMEDIATION", 5],
                ["ASSIGNED", "IN_REMEDIATION", "IN_REMEDIATION", 8]],
     "expected": 5},
    {"name": "repeated reassignments during remediation",
     "events": [["IN_REMEDIATION", "TRIAGED", "IN_REMEDIATION", 5], ["ASSIGNED", "IN_REMEDIATION", "IN_REMEDIATION", 8],
                ["ASSIGNED", "IN_REMEDIATION", "IN_REMEDIATION", 9], ["PENDING_VERIFICATION", "IN_REMEDIATION", "PENDING_VERIFICATION", 11]],
     "expected": 5},
    {"name": "pending verification keeps the cycle start",
     "events": [["IN_REMEDIATION", "TRIAGED", "IN_REMEDIATION", 5], ["PENDING_VERIFICATION", "IN_REMEDIATION", "PENDING_VERIFICATION", 7],
                ["ASSIGNED", "PENDING_VERIFICATION", "PENDING_VERIFICATION", 8]],
     "expected": 5},
    {"name": "returned to remediation starts a new cycle",
     "events": [["CREATED", null, "OPEN", 1], ["IN_REMEDIATION", "TRIAGED", "IN_REMEDIATION", 5],
                ["PENDING_VERIFICATION", "IN_REMEDIATION", "PENDING_VERIFICATION", 7], ["IN_REMEDIATION", "PENDING_VERIFICATION", "IN_REMEDIATION", 9],
                ["PENDING_VERIFICATION", "IN_REMEDIATION", "PENDING_VERIFICATION", 12]],
     "expected": 9},
    {"name": "reassigned after returning to remediation",
     "events": [["IN_REMEDIATION", "TRIAGED", "IN_REMEDIATION", 5], ["PENDING_VERIFICATION", "IN_REMEDIATION", "PENDING_VERIFICATION", 7],
                ["IN_REMEDIATION", "PENDING_VERIFICATION", "IN_REMEDIATION", 9], ["ASSIGNED", "IN_REMEDIATION", "IN_REMEDIATION", 10]],
     "expected": 9},
    {"name": "migration baseline already in remediation",
     "events": [["BASELINE", null, "IN_REMEDIATION", 4]],
     "expected": 4},
    {"name": "migration baseline, then reassigned",
     "events": [["BASELINE", null, "IN_REMEDIATION", 4], ["ASSIGNED", "IN_REMEDIATION", "IN_REMEDIATION", 6]],
     "expected": 4}
  ]
}
