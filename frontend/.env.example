# Copy to .env.local or .env.development.local (both ignored by git; never commit them) and adjust. This template is the
# only frontend env file that belongs in the repository. Never put secrets in NEXT_PUBLIC_* variables:
# they are compiled into the browser bundle.
# Backend API base (the backend mounts its routes under /api).
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Demo/dev only: set to 1 (with backend ZA_DEMO_MODE=1) to list demo account emails on the sign-in page.
# NEXT_PUBLIC_ZA_DEMO_MODE=1
